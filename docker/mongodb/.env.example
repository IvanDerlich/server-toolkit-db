# Copy this file to .env and fill in real values.

# Container identity and image version.
MONGODB_CONTAINER_NAME=app-mongodb
MONGODB_IMAGE_TAG=8.2
MONGODB_HOST_PORT=27017
MONGODB_VOLUME_NAME=app-mongodb-data

# Hostname shown in the setup guide connection commands (defaults to localhost).
MONGODB_DOMAIN=s1.ivanderlich.com

# Non-root container user/group (enforced by validation).
MONGODB_UID=999
MONGODB_GID=999

# Administrative account.
MONGODB_ROOT_USERNAME=root-aoeua4445e
MONGODB_ROOT_PASSWORD=change_me_root_password

# Application database/account created on first initialization only.
MONGODB_APP_DATABASE=appdb
MONGODB_APP_USERNAME=appuser-loeuin45299
MONGODB_APP_PASSWORD=change_me_app_password