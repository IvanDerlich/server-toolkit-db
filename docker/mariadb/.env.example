# Example environment file for MariaDB Docker Compose
# Copy to .env and edit values as needed

MARIADB_ROOT_PASSWORD=changeme_root_pw
MARIADB_DATABASE=app
MARIADB_USER=appuser
MARIADB_PASSWORD=changeme_app_pw
MARIADB_PORT=3306
MARIADB_CONTAINER_NAME=mariadb-hardened
MARIADB_VOLUME_NAME=mariadb_data
