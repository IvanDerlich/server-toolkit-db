# Copy this file to .env and fill in real values.

RESTIC_IMAGE_TAG=0.17.3
RESTIC_CONTAINER_NAME=restic
RESTIC_UID=1000
RESTIC_GID=1000
RESTIC_VOLUME_NAME=restic_repo

# Absolute or relative host path to back up.
RESTIC_SOURCE_PATH=../../

# Local repository path in the container by default.
RESTIC_REPOSITORY=/repo
RESTIC_PASSWORD=change_me_restic_password

# Optional timezone and AWS credentials for S3-backed repositories.
TZ=UTC
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=